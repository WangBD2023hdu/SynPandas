{# CSS for 模板2: 表头不重复 - 只在第一页显示表头 #}

.container h3 {
  margin-bottom: {{styles.gap.h3p_gap}};
  text-align: {{styles.h3location|default("left")}};
}

.container p {
  margin-top: 0px;
  line-height: {{ styles.line_height }};
  text-indent: 2em;
  margin-bottom: 0px;
}

body {
  height: 100%;
  margin: 0;
  padding: 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

p {
  word-break: break-all;
}

.a4-page {
  width: 210mm;
  min-height: 297mm;
  border: 1px solid #ccc;
  display: flex;
  flex-direction: column;
  padding: 15mm;
  padding-top: 0mm;
  padding-bottom: 0mm;
  page-break-after: always;
  box-sizing: border-box;
  position: relative;
  overflow: visible;
  justify-content: flex-start;
}

.main_content {
  column-count: {{styles.columns}};
  column-gap: 16px;
  padding-top: 2mm;
  padding-bottom: 0mm;
  box-sizing: border-box;
}

.header {
  width: calc(100% - 40mm);
  height: 12mm;
  background-color: {{styles.header.background_color}};
  padding: 6px 10px;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: absolute;
  top: 20mm;
  left: 20mm;
  right: 20mm;
  z-index: 1000;
  font-family: 'Arial', sans-serif;
  font-size: 12px;
  font-weight: bold;
  text-align: center;
}

.header-left,
.header-mid,
.header-right {
  font-size: 10px;
  text-align: center;
}

.footer {
  width: calc(100% - 40mm);
  height: 12mm;
  border-top: 2px solid black;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 10px;
  box-sizing: border-box;
  background-color: {{styles.header.background_color}};
  position: absolute;
  bottom: 20mm;
  left: 20mm;
  right: 20mm;
}

.footer-left,
.footer-mid,
.footer-right {
  flex: 1;
  text-align: center;
}

.table_outer {
  width: 100%;
  margin: 1px auto;
}

.table_caption {
  width: max-content;
  margin: 16px auto;
  text-align: left;
  font-size: 12px;
}

.table_footnote {
  width: max-content;
  text-align: left;
  font-size: 11px;
}

.table-block {
  width: 100%;
  text-align: center;
}

/* ==========================================================
   CSS 修改重点：表头不重复模式 (Mode 2)
   ========================================================== */

.table-no-repeat-header .table-block table {
  margin: 0;
  font-size: 10px;
  border-collapse: collapse;
  width: 100%;
  border: 1px solid #ffffff;
}

.table-no-repeat-header .table-block table thead {
  /* 核心修改：将其视为普通行组，禁止浏览器自动跨页重复 */
  display: table-row-group; 
}

.table-no-repeat-header .table-block table tbody {
  display: table-row-group;
}

.table-no-repeat-header .table-block table tr {
  /* 核心修改：防止行内内容被切断（保持单元格完整） */
  break-inside: avoid;
  page-break-inside: avoid;
}

.table-no-repeat-header .table-block th,
.table-no-repeat-header .table-block td {
  padding: 2px 2px;
  border: 1px solid #ddd;
  font-size: 8px;
  text-align: center;
  border-left: none;
  border-right: none;
  border-top: 1px solid #ccc;
  border-bottom: 1px solid #ccc;
  font-weight: bold;
}

.table-no-repeat-header .table-block table thead tr:first-child th {
  border-top: 2px solid #000;
}

/* 打印时的特定优化 */
@media print {
  html, body {
    margin: 0;
    padding: 0;
  }

  .a4-page {
    width: 210mm;
    min-height: calc(297mm - 0.5mm);
    box-sizing: border-box;
    overflow: visible;
    border: none !important;   /* 打印不出框 */
    box-shadow: none !important;
  }

  /* 再次强制确保打印时表头不重复 */
  .table-no-repeat-header .table-block table thead {
     display: table-row-group !important;
  }
  
  table { border-collapse: collapse; }
  tr { break-inside: avoid; page-break-inside: avoid; }
  td, th { break-inside: avoid; page-break-inside: avoid; }
  
  /* 再次强制确保行不被切断 */
  .table-no-repeat-header .table-block table tr {
     break-inside: avoid !important;
     page-break-inside: avoid !important;
  }
}

h3 {
  font-size: 18px;
  margin-bottom: 4px;
}

.text {
  font-size: 16px;
  text-align: left;
  text-indent: 4ch;
  line-height: 1.2;
  margin: 2px auto;
}

@page {
  size: A4;
  margin: 15mm 0 15mm 0 !important;
}

@media print {
  th, td { background-image: none !important; }
}

@media print {
  table { border: 0 !important; outline: 0 !important; box-shadow: none !important; }
  thead, tbody, tfoot, tr, colgroup, caption { border: 0 !important; outline: 0 !important; box-shadow: none !important; }
  th, td { border: 1px solid #000 !important; box-shadow: none !important; outline: 0 !important; }
}

