              <div class="footer-left">{{ footer.left }}</div>
            {% endif %}
            {% if footer.mid %}
              <div class="footer-mid">{{ footer.mid }}</div>
            {% endif %}
            {% if footer.right %}
              <div class="footer-right">{{ footer.right }}</div>
            {% endif %}
          </div>
        {% endif %} #}
        
        </div>

<script>
(function () {
  'use strict';

  function setCellStyle(cell, cssObj) {
    const st = cell.style;
    for (const k in cssObj) st[k] = cssObj[k];
  }

  function pickHeaderRow(tbl) {
    const thead = tbl.querySelector('thead');
    if (thead) {
      const rows = thead.querySelectorAll('tr');
      if (rows.length) return rows[rows.length - 1];
    }
    const tbody = tbl.querySelector('tbody');
    if (tbody) {
      const row = tbody.querySelector('tr');
      if (row) return row;
    }
    return tbl.querySelector('tr');
  }

  function styleFullBorderOnly(tbl) {
    tbl.style.borderCollapse = 'collapse';
    // tbl.style.border = '1px solid #000'; 跨页表格 页脚栏
    tbl.style.border = '0'; 
    
    

    // ✅ 随机字号：10/11/12（每表一次）
    const fontSizes = ['10px', '11px', '12px'];
    const fontSize = fontSizes[(Math.random() * fontSizes.length) | 0];

    // ✅ 随机对齐：全表一致（center/left）
    const align = Math.random() < 0.5 ? 'center' : 'left';

    // ✅ 浅灰背景更明显一点
    const graySolid = '#e9e9e9';
    const grayBg = 'none'; // `linear-gradient(${graySolid}, ${graySolid})`;
    


    const cells = tbl.querySelectorAll('th, td');
    cells.forEach(cell => {
      setCellStyle(cell, {
        border: '1px solid #000',
        textAlign: align,              // ✅ 全表一致
        verticalAlign: 'middle',
        padding: '6px 8px',
        fontSize: fontSize,
        fontFamily: 'Arial, "Helvetica Neue", Helvetica, sans-serif'
      });
    });

    // ✅ 随机：表头行 or 第一列，上浅灰（每表一次）
    const paintHeader = Math.random() < 0.5;
    if (paintHeader) {
      const headerRow = pickHeaderRow(tbl);
      if (headerRow) {
        headerRow.querySelectorAll('th, td').forEach(cell => {
          cell.style.backgroundImage = grayBg;
          cell.style.backgroundColor = graySolid;
        });
      }
    } else {
      const rows = tbl.querySelectorAll('tr');
      rows.forEach(r => {
        const first = r.querySelector('th, td');
        if (first) {
          first.style.backgroundImage = grayBg;
          first.style.backgroundColor = graySolid;
        }
      });
    }
  }

  function styleOneTable(tbl) {
    if (tbl.dataset.styled === '1') return;
    styleFullBorderOnly(tbl);
    tbl.dataset.styled = '1';
  }

  function styleTables(root) {
    const scope = root || document;
    scope.querySelectorAll('table:not([data-styled])').forEach(styleOneTable);
  }

  function run() {
    styleTables(document);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run, { once: true });
  } else {
    run();
  }

  const obs = new MutationObserver(mutations => {
    for (const m of mutations) {
      for (const node of m.addedNodes) {
        if (node.nodeType !== 1) continue;
        if (node.tagName && node.tagName.toLowerCase() === 'table') {
          styleOneTable(node);
        } else {
          styleTables(node);
        }
      }
    }
  });
  obs.observe(document.documentElement, { childList: true, subtree: true });

  window.styleTables = styleTables;
})();
</script>

  <script>
  window.MathJax = {
    startup: { typeset: true },

    tex: {
      inlineMath: [['$', '$'], ['\\(', '\\)']],
      displayMath: [['$$', '$$'], ['\\[', '\\]']],

      processEscapes: true, 
      tags: 'none'      
    },

    options: {
      skipHtmlTags: ['script','noscript','style','textarea','pre','code']
    }
  };
  </script>

<script>
(function () {
  'use strict';

  const fonts = {
    english: [
      "Times New Roman",
      "Georgia",
      "Garamond",
      "Arial",
      "Helvetica",
      "Verdana"
    ],
    chinese: [
      "SimSun",
      "NSimSun",
      "SimHei",
      "Microsoft YaHei",
      "KaiTi",
      "FangSong"
    ]
  };

  function pick(arr) {
    return arr[(Math.random() * arr.length) | 0];
  }

  function q(name) { return `"${name}"`; }

  function ensureStyleTag(id) {
    let el = document.getElementById(id);
    if (!el) {
      el = document.createElement('style');
      el.id = id;
      document.head.appendChild(el);
    }
    return el;
  }

  /**
   * rootSelector: null => 全局；否则只作用在某个容器下（推荐 '.a4-page'）
   */
  function applyRandomFonts(rootSelector) {
    const en = pick(fonts.english);
    const zh = pick(fonts.chinese);

    // 作用域选择器：全局 or 局部
    const scope = rootSelector ? `${rootSelector}` : '';

    // 英文与中文分别的 font-family（各自有兜底）
    const enStack = [q(en), "serif", "sans-serif"].join(", ");
    const zhStack = [q(zh), "serif", "sans-serif"].join(", ");

    // 没有 lang 标记时的兜底：同时包含中英（谁先谁后按你偏好）
    const mixedStack = [q(zh), q(en), "serif", "sans-serif"].join(", ");

    // 写入样式
    const styleEl = ensureStyleTag('rand-font-lang-split');
    styleEl.textContent = `
${scope || 'body'} { font-family: ${mixedStack}; }

/* 英文优先：有 lang=en 时 */
${scope ? `${scope} ` : ''}:lang(en) { font-family: ${enStack}; }

/* 中文优先：常见中文 lang 标记 */
${scope ? `${scope} ` : ''}:lang(zh),
${scope ? `${scope} ` : ''}:lang(zh-CN),
${scope ? `${scope} ` : ''}:lang(zh-Hans),
${scope ? `${scope} ` : ''}:lang(zh-Hant) { font-family: ${zhStack}; }
`;

    // 记录一下方便调试
    const root = rootSelector ? document.querySelector(rootSelector) : document.body;
    if (root) {
      root.dataset.fontEnglish = en;
      root.dataset.fontChinese = zh;
    }
  }

  function run() {
    // 全局生效：applyRandomFonts(null)
    // 只对打印容器：applyRandomFonts('.a4-page')
    applyRandomFonts(null);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run, { once: true });
  } else {
    run();
  }

  window.applyRandomFonts = applyRandomFonts;
})();
</script>


