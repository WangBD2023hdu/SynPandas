{# CSS for 模板3: 单元格跨页 - 允许单元格内容跨页显示 #}

.container h3 {
  margin-bottom: {{styles.gap.h3p_gap}};
  text-align: {{styles.h3location|default("left")}};
}

.container p {
  margin-top: 0px;
  line-height: {{ styles.line_height }};
  text-indent: 2em;
  margin-bottom: 0px;
}

body {
  height: 100%;
  margin: 0;
  padding: 0;
  display: flex;
  justify-content: center;
  align-items: center;
}

p {
  word-break: break-all;
}

.a4-page {
  width: 210mm;
  min-height: 297mm;
  border: 1px solid #ccc;
  display: flex;
  flex-direction: column;
  padding: 20mm;
  page-break-after: always;
  box-sizing: border-box;
  position: relative;
  overflow: visible;
  justify-content: flex-start;
}

.main_content {
  column-count: {{styles.columns}};
  column-gap: 16px;
  padding-top: 22mm;
  padding-bottom: 28mm;
  box-sizing: border-box;
}

.header {
  width: calc(100% - 40mm);
  height: 12mm;
  background-color: {{styles.header.background_color}};
  padding: 6px 10px;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: absolute;
  top: 20mm;
  left: 20mm;
  right: 20mm;
  z-index: 1000;
  font-family: 'Arial', sans-serif;
  font-size: 12px;
  font-weight: bold;
  text-align: center;
}

.header-left,
.header-mid,
.header-right {
  font-size: 10px;
  text-align: center;
}

.footer {
  width: calc(100% - 40mm);
  height: 12mm;
  border-top: 2px solid black;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 6px 10px;
  box-sizing: border-box;
  background-color: {{styles.header.background_color}};
  position: absolute;
  bottom: 20mm;
  left: 20mm;
  right: 20mm;
}

.footer-left,
.footer-mid,
.footer-right {
  flex: 1;
  text-align: center;
}

.table_outer {
  width: 67%;
  margin: 1px auto;
}

.table_caption {
  width: max-content;
  margin: 16px auto;
  text-align: left;
  font-size: 12px;
}

.table_footnote {
  width: max-content;
  text-align: left;
  font-size: 11px;
}

.table-block {
  width: 100%;
  text-align: center;
}
{# ============================
  模板3：单元格跨页（row 可拆分）
  适配：table_outer.table-cell-break + JS 动态 table style
============================ #}

/* --- 强烈建议：打印时不要用 flex 居中，否则分页计算容易怪 --- */
@media print {
  html, body {
    margin: 0 !important;
    padding: 0 !important;
    height: auto !important;
  }
  body {
    display: block !important;
    justify-content: unset !important;
    align-items: unset !important;
  }
}

/* 页面容器：保持你原有结构 */
.a4-page {
  width: 210mm;
  min-height: calc(297mm - 0.5mm);
  box-sizing: border-box;
  overflow: visible;
}

/* 你原来 main_content 有 columns；columns 会影响分页与表格跨页稳定性
   如果你的表格确实需要跨页，建议表格区域不走多栏排版。
   下面做局部隔离：table_outer 内部强制单栏。 */
.table_outer {
  break-inside: auto;
  page-break-inside: auto;
}

/* ✅ 关键：表格容器内禁用多栏（否则分页/跨页非常不稳定） */
.table_outer.table-cell-break {
  column-count: 1 !important;
  column-gap: 0 !important;
}

/* 表格外层宽度：保持你现有设定 */
.table_outer {
  width: 100%;
  margin: 1px auto;
}

/* caption/footnote 不要被拆到奇怪的位置 */
.table_caption,
.table_footnote {
  break-inside: avoid;
  page-break-inside: avoid;
}

/* ============================
   核心：table / tr / td 的分页与断行策略
============================ */

/* table：固定布局 + 允许碎片化 */
.table-cell-break .table-block table {
  width: 100%;
  border-collapse: collapse;
  table-layout: fixed;              /* ✅ 更利于断行与分页稳定 */
  break-inside: auto;
  page-break-inside: auto;
}

/* thead：你希望表头重复就保留 header-group；
   如果你“不重复表头”，把这行改成 table-row-group */
.table-cell-break .table-block table thead {
  display: table-header-group;
}

/* ✅ demo 模式3 的关键：行可拆分 */
.table-cell-break .table-block table tr {
  break-inside: auto !important;
  page-break-inside: auto !important;
  page-break-after: auto !important;
}

/* td/th：断行更激进 + 顶部对齐（覆盖 JS inline 的 middle） */
.table-cell-break .table-block th,
.table-cell-break .table-block td {
  /* 断行策略：避免长英文/数字/URL 把列撑爆导致整行推走 */
  white-space: normal !important;
  word-break: break-word !important;
  overflow-wrap: anywhere !important;   /* ✅ 比 break-word 更狠 */
  hyphens: auto !important;

  /* 跨页观感：顶部对齐更自然（JS 会写 middle，所以用 !important） */
  vertical-align: top !important;

  /* 不要阻止分页 */
  break-inside: auto !important;
  page-break-inside: auto !important;
}

/* 表头行仍避免跨页（否则表头会被切开） */
.table-cell-break .table-block table thead tr {
  break-inside: avoid !important;
  page-break-inside: avoid !important;
}

/* ============================
   打印态强化：Chromium printToPDF 更依赖 @media print + !important
============================ */
@media print {
  .table-cell-break .table-block table {
    break-inside: auto !important;
    page-break-inside: auto !important;
  }

  .table-cell-break .table-block table tbody {
    break-inside: auto !important;
    page-break-inside: auto !important;
  }

  .table-cell-break .table-block table tr,
  .table-cell-break .table-block th,
  .table-cell-break .table-block td {
    break-inside: auto !important;
    page-break-inside: auto !important;
  }

  /* 如果你发现某些浏览器把大行整体挪走，可尝试允许“更激进的切分”：
     下面这行一般不需要，但在极端长行时能减少整行推到下一页 */
  /* .table-cell-break .table-block table { page-break-after: auto !important; } */
}

/* 页边距 */
@page {
  size: A4;
  margin: 15mm 0 15mm 0 !important;
  border: 1px solid #000; !important;   /* 打印不出框 */
}
